<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Backend URL (no trailing slash) -->
    <key>backendBaseURL</key>
    <string>https://video-slacker.onrender.com</string>

    <key>backendStagingURL</key>
    <string>https://video-slacker.onrender.com</string>

    <!-- OAuth2 Configuration (PKCE via Safari) -->
    <key>oauth</key>
    <dict>
        <key>clientId</key>
        <string>video-slacker-ios</string>
        <key>redirectUri</key>
        <string>videoslacker://oauth-callback</string>
        <key>scopes</key>
        <array>
            <string>read</string>
            <string>write</string>
        </array>
    </dict>

    <!-- Feature Flags -->
    <key>features</key>
    <dict>
        <key>enableDebugLogging</key>
        <false/>
        <key>enableFileAttachments</key>
        <false/>
    </dict>
</dict>
</plist>
